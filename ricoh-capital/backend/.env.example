PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
ORACLE_WALLET_DIR=

# Long random strings, different from each other. Generate e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Or: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

OCI_REGION=
OCI_TENANCY_ID=
OCI_USER_ID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_PATH=
OCI_PASSPHRASE=
OCI_NAMESPACE=
# Use your bucket API name (e.g. oci-tech-squad). Display names may differ.
OCI_BUCKET_DOCUMENTS=documents
OCI_BUCKET_CONTRACTS=contracts
# Virtual folder prefix inside the bucket (optional). Example: Ricoh → keys like Ricoh/<userId>/...
OCI_DOCUMENTS_PREFIX=
OCI_CONTRACTS_PREFIX=
